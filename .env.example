# ============================================================
# AI Job Hunter - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Application ---
APP_NAME=AI Job Hunter
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/job_hunter.db

# --- Google Gemini ---
GOOGLE_API_KEY=your-google-api-key-from-aistudio
GEMINI_MODEL=gemini-2.5-flash

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_RESUMES=resumes
CHROMA_COLLECTION_JOBS=jobs

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- File Storage ---
UPLOAD_DIR=./data/uploads
GENERATED_DIR=./data/generated

# --- Job Sources ---
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=1

# --- Frontend ---
BACKEND_URL=http://localhost:8000
STREAMLIT_PORT=8501
